# ── Environment ───────────────────────────────────────────────────────────────
.env
# Every copy of it too: a backup like `.env.before-x` holds the same secrets.
.env.*
!.env.example
!.env.local.example

# ── Secrets that could land in the tree ───────────────────────────────────────
# A deploy to GKE (deploy/charts) uses a kubeconfig and maybe a service
# account key; a stray `--kubeconfig ./…` or a copied file must never ship.
kubeconfig
*.kubeconfig
.kube/
service-account-*.json
*-sa-key.json
application_default_credentials.json
*.pem
*.key
*.p12
# crates.io credentials belong in ~/.cargo, and a per-machine cargo override
# (a path to a local checkout) points everyone else at a directory not there.
.cargo/credentials.toml
.cargo/credentials
.cargo/config.toml

# ── AI / tooling state ────────────────────────────────────────────────────────
.claude/
.agents/
.gemini/
.aider*
.cursor/

# ── Rust ──────────────────────────────────────────────────────────────────────
# Cargo.lock is committed for reproducible builds.
target/
*.rs.bk

# ── Node / Next.js (web/) ─────────────────────────────────────────────────────
node_modules/
.next/
# Fumadocs MDX writes the book's index here at build (`web/lib/source.ts`).
web/.source/
# The book itself, telmoni/docs, laid in by `make book` (scripts/book.sh).
web/content/docs/
*.tsbuildinfo
next-env.d.ts
.eslintcache
npm-debug.log*

# ── SDKs (sdk/) ───────────────────────────────────────────────────────────────
# Four ecosystems in one tree, each vendoring differently; node_modules/ is
# already ignored above.
sdk/*/dist/
sdk/*/.venv/
sdk/**/__pycache__/
sdk/*/.pytest_cache/
sdk/*/.mypy_cache/
sdk/*/.ruff_cache/
sdk/**/*.egg-info/
sdk/**/*.pyc

# ── Test artifacts ────────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# ── Local ─────────────────────────────────────────────────────────────────────
# The maintainer's own notes, never repo docs.
scratch/
docker-compose.override.yml
*.pid
# Root-anchored: a bare `logs/` would also hide a console route named logs.
*.log
/logs/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.zed/
*.swp
*.swo
*.orig
*.rej
*.bak
.DS_Store
._*
Thumbs.db
