# The server's local env. `make env-scaffold` copies this to .env and mints
# SERVICE_SECRET. The console reads web/.env.local. A blank value is unset.

# ── Databases ──────────────────────────────────────────────────────────────
# One role per module; the docker Postgres creates them. `make db-reset`
# rebuilds the instance.
AUTH_DATABASE_URL=postgresql://auth:auth_dev@localhost:5432/telmoni
NOTIFICATIONS_DATABASE_URL=postgresql://notifications:notifications_dev@localhost:5432/telmoni
AGENT_DATABASE_URL=postgresql://agent:agent_dev@localhost:5432/telmoni
TELEMETRY_DATABASE_URL=postgresql://telemetry:telemetry_dev@localhost:5432/telmoni
MIGRATOR_DATABASE_URL=postgresql://migrator:migrator_dev@localhost:5432/telmoni

# ClickHouse's HTTP interface, each URL carrying its user and password as a
# DSN does: the module's user, held by the row policy, and the one `migrate`
# and `rotate` run as. The docker ClickHouse has both
# (crates/telemetry/clickhouse/dev-users.xml).
TELEMETRY_CLICKHOUSE_URL=http://telemetry:telemetry_dev@localhost:8123
MIGRATOR_CLICKHOUSE_URL=http://migrator:migrator_dev@localhost:8123

# ── Telemetry ──────────────────────────────────────────────────────────────
# The key each project's hashing key is sealed under, which the user ids its
# spans carry are hashed with before they are stored: `local:` +
# `openssl rand -hex 32` on a laptop, a Cloud KMS key name on a tier. Ingest's
# claims on each export and its rate limits live in the console's Redis.
TELEMETRY_KEK=
REDIS_URL=redis://localhost:6379
# How many X-Forwarded-For entries the proxies in front of the server append:
# the machine lanes' per-address limits read the caller's address past them.
# Nothing is in front on a laptop, so the socket's own peer is the address.
TRUSTED_PROXY_HOPS=0
# The console agent reports its own questions as runs with the Rust SDK, as
# any agent does — each question a run, its model and tool calls its spans,
# the asking organization its user, hashed as every user id is — under an
# ingest key of a project of your own: the SDK's own TELMONI_API_KEY, and
# TELMONI_ENDPOINT, this server's own address, http://127.0.0.1:$PORT, unless
# set. Unset, nothing records them.
TELMONI_API_KEY=

# ── Service trust ──────────────────────────────────────────────────────────
# Must equal web/.env.local's, or every console call fails with a 401.
SERVICE_SECRET=

# ── Sign-in ────────────────────────────────────────────────────────────────
# The password form, and whether anybody new may sign up,
# at the form or at a provider (an invited address always may: true unless
# set). ADMIN_EMAIL and ADMIN_PASSWORD create the first account at boot
# (both or neither). Addresses at the domains listed sign in at a provider
# alone.
AUTH_DISABLE_USERNAME_PASSWORD=false
AUTH_DISABLE_SIGNUP=false
AUTH_DOMAINS_WITH_SSO_ENFORCEMENT=
VERIFY_EMAIL=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where every person created starts: an organization's id, from its
# Settings, joined as a member
# unless the role is admin, and one of its projects, seated as a member
# unless the role is admin. Once, as they are created; boot refuses an id
# that names no active organization, or a project outside it.
TELMONI_DEFAULT_ORG_ID=
TELMONI_DEFAULT_ORG_ROLE=
TELMONI_DEFAULT_PROJECT_ID=
TELMONI_DEFAULT_PROJECT_ROLE=

# One callback for every provider: register it as a redirect URI and its
# origin as a post-logout URI, and add the provider's origin to
# web/.env.local's AUTH_PROVIDER_ORIGINS.
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# An OpenID Connect provider beside the form, on when its client id is set.
# The checks are of pkce, nonce and state (all three unless set); the id
# token's algorithm RS256 unless set (RS384, RS512, PS256, PS384, PS512,
# ES256 or ES384); userinfo read for a provider that keeps the address or
# the name out of its id tokens; and an unknown subject linked to the account
# holding its address only where linking is on and both the provider and the
# account proved it. To try one locally, COMPOSE_PROFILES=oidc starts Dex
# (crates/auth/dex/dev-config.yaml): set the client id telmoni-local, the
# secret telmoni-local-dex-secret, the issuer http://127.0.0.1:5556/dex and
# the name Dex, then sign in as ada@example.com with `password`.
AUTH_CUSTOM_CLIENT_ID=
AUTH_CUSTOM_CLIENT_SECRET=
AUTH_CUSTOM_ISSUER=
AUTH_CUSTOM_NAME=
AUTH_CUSTOM_SCOPE=openid email profile
AUTH_CUSTOM_CHECKS=pkce,nonce,state
AUTH_CUSTOM_ID_TOKEN_SIGNED_RESPONSE_ALG=RS256
AUTH_CUSTOM_FETCH_USERINFO=false
AUTH_CUSTOM_ALLOW_ACCOUNT_LINKING=false

# ── Public URL ─────────────────────────────────────────────────────────────
# The console's origin, for links in mail, the connector callbacks, the
# vote an alert's notices link, and the docs the agent indexes.
APP_URL=http://localhost:3000

# ── Live pages ─────────────────────────────────────────────────────────────
# Seconds a page reading a project's spans — a trace's or a session's page,
# or a Sessions or Users list — holds between redraws as they arrive: the
# first export after a quiet spell draws at once, the rest once, when the
# hold ends. The Traces list counts them in a bar instead. The console's own variable
# (web/.env.local), which `make up` and `make web-dev` pass from here when it
# is set; unset is 30, and 0 draws on every export.
LIVE_REFRESH_HOLD_SECS=

# ── Mail ───────────────────────────────────────────────────────────────────
# The Mailpit `make up` starts (http://localhost:8025). Unset, mail is only
# logged. SUPPORT_EMAIL is the operator's address; unset, mail names none.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Telmoni <no-reply@localhost>"
SUPPORT_EMAIL=

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Connectors (Slack, webhooks) ───────────────────────────────────────────
# Optional. Either needs CONNECTOR_KEK: `local:` + `openssl rand -hex 32`
# on a laptop, a Cloud KMS key name on a tier. Slack needs an HTTPS tunnel.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
CONNECTOR_KEK=

# ── The agent ──────────────────────────────────────────────────────────────
# Off while AGENT_MODEL_PROVIDER is empty. The provider is the protocol,
# `anthropic` or `openai` (also Gemini, Ollama, vLLM). For Gemini set it to
# `openai` and put one Google AI Studio key in both *_API_KEY lines.
# Embeddings must be 768 wide; for local ones, COMPOSE_PROFILES=ollama,
# EMBEDDINGS_URL=http://localhost:11434/v1, EMBEDDINGS_MODEL=nomic-embed-text
# and no EMBEDDINGS_REQUEST_DIMENSIONS. After changing the embeddings model,
# `make sweep SWEEP=agent-reindex`. The docs it indexes are this console's
# own, APP_URL/llms-full.txt, which `make up` serves; DOCS_CORPUS_URL names
# another corpus, or `off` for none.
AGENT_MODEL_PROVIDER=
AGENT_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_MODEL_API_KEY=
EMBEDDINGS_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_API_KEY=
EMBEDDINGS_REQUEST_DIMENSIONS=true

# ── Unset on purpose (defaults shown) ──────────────────────────────────────
# A set value that doesn't parse refuses boot.
#   PORT=8082  RUN_SWEEPS=true  ALLOW_TEST_SESSION=false (refused in a pod)
#   AGENT_MESSAGES_PER_HOUR=60  AGENT_MAX_TOKENS=8192  AGENT_MODEL_TIMEOUT_SECS=60
#   DOCS_CORPUS_URL=$APP_URL/llms-full.txt (off: no docs)
#   RERANK_URL  RERANK_MODEL  RERANK_API_KEY
#   NOTIFICATIONS_DELIVERY_POLL_SECS=5  _MAX_ATTEMPTS=5  _BACKOFF_SECS=30
#   NOTIFICATIONS_DELIVERY_BATCH=200  _CONCURRENCY=64  _DRAIN_ROUNDS=20
#   DELETION_TAIL_BUDGET_MS  SERVICE_SECRET_NEXT  DATABASE_CA_CERT
#   KMS_API_BASE  METADATA_API_BASE  SLACK_API_BASE
#   MIGRATION_SETS  MIGRATIONS_ROOT  MIGRATION_GRANTS
