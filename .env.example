# The server's local env. `make env-scaffold` copies this to .env and mints
# SERVICE_SECRET. The console reads web/.env.local. A blank value is unset.

# ── Databases ──────────────────────────────────────────────────────────────
# One role per module; the docker Postgres creates them. `make db-reset`
# rebuilds the instance.
AUTH_DATABASE_URL=postgresql://auth:auth_dev@localhost:5432/telmoni
NOTIFICATIONS_DATABASE_URL=postgresql://notifications:notifications_dev@localhost:5432/telmoni
AGENT_DATABASE_URL=postgresql://agent:agent_dev@localhost:5432/telmoni
MIGRATOR_DATABASE_URL=postgresql://migrator:migrator_dev@localhost:5432/telmoni

# ── Service trust ──────────────────────────────────────────────────────────
# Must equal web/.env.local's, or every console call fails with a 401.
SERVICE_SECRET=

# ── Sign-in ────────────────────────────────────────────────────────────────
# The password form. ADMIN_EMAIL and ADMIN_PASSWORD create the first account
# at boot (both or neither).
DISABLE_LOGIN_FORM=false
ALLOW_SIGN_UP=true
VERIFY_EMAIL=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# An OpenID Connect provider beside the form. Register OIDC_REDIRECT_URI as a
# redirect URI and its origin as a post-logout URI, and add the provider's
# origin to web/.env.local's AUTH_PROVIDER_ORIGINS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_ALLOW_SIGN_UP=true
OIDC_ALLOW_INSECURE_EMAIL_LOOKUP=false

# ── Public URL ─────────────────────────────────────────────────────────────
# The console's origin, for links in mail, the connector callbacks and the
# docs the agent indexes.
APP_URL=http://localhost:3000

# ── Mail ───────────────────────────────────────────────────────────────────
# The Mailpit `make up` starts (http://localhost:8025). Unset, mail is only
# logged. SUPPORT_EMAIL is the operator's address; unset, mail names none.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Telmoni <no-reply@localhost>"
SUPPORT_EMAIL=

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Connectors (Slack, Discord, webhooks) ──────────────────────────────────
# Optional. Any of them needs CONNECTOR_KEK: `local:` + `openssl rand -hex 32`
# on a laptop, a Cloud KMS key name on a tier. Slack needs an HTTPS tunnel.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
CONNECTOR_KEK=

# ── The agent ──────────────────────────────────────────────────────────────
# Off while AGENT_MODEL_PROVIDER is empty. The provider is the protocol,
# `anthropic` or `openai` (also Gemini, Ollama, vLLM). For Gemini set it to
# `openai` and put one Google AI Studio key in both *_API_KEY lines.
# Embeddings must be 768 wide; for local ones, COMPOSE_PROFILES=ollama,
# EMBEDDINGS_URL=http://localhost:11434/v1, EMBEDDINGS_MODEL=nomic-embed-text
# and no EMBEDDINGS_REQUEST_DIMENSIONS. After changing the embeddings model,
# `make sweep SWEEP=agent-reindex`. The docs it indexes are this console's
# own, APP_URL/llms-full.txt, which `make up` serves; DOCS_CORPUS_URL names
# another corpus, or `off` for none.
AGENT_MODEL_PROVIDER=
AGENT_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT_MODEL=gemini-3.8-flash
AGENT_MODEL_API_KEY=
EMBEDDINGS_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_API_KEY=
EMBEDDINGS_REQUEST_DIMENSIONS=true

# ── Unset on purpose (defaults shown) ──────────────────────────────────────
# A set value that doesn't parse refuses boot.
#   PORT=8082  RUN_SWEEPS=true  ALLOW_TEST_SESSION=false (refused in a pod)
#   AGENT_MESSAGES_PER_HOUR=60  AGENT_MAX_TOKENS=8192  AGENT_MODEL_TIMEOUT_SECS=60
#   DOCS_CORPUS_URL=$APP_URL/llms-full.txt (off: no docs)
#   RERANK_URL  RERANK_MODEL  RERANK_API_KEY
#   NOTIFICATIONS_DELIVERY_POLL_SECS=5  _MAX_ATTEMPTS=5  _BACKOFF_SECS=30
#   NOTIFICATIONS_DELIVERY_BATCH=200  _CONCURRENCY=64  _DRAIN_ROUNDS=20
#   DELETION_TAIL_BUDGET_MS  SERVICE_SECRET_NEXT  DATABASE_CA_CERT
#   KMS_API_BASE  METADATA_API_BASE  SLACK_API_BASE  DISCORD_API_BASE
#   MIGRATION_SETS  MIGRATIONS_ROOT  MIGRATION_GRANTS
