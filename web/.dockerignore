# ── Build output (rebuilt inside Docker) ─────────────────────────────────────
.next/
out/
build/
dist/

# ── Dependencies (installed inside Docker) ────────────────────────────────────
node_modules/

# ── Test artifacts ────────────────────────────────────────────────────────────
coverage/
tests/
**/__tests__/
**/*.test.ts
**/*.spec.ts
test-results/
playwright-report/
blob-report/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Secrets (provided by the cluster at runtime, never baked into image) ─────
.env
.env.*
*.pem
*.key
*.cert

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Documentation ─────────────────────────────────────────────────────────────
*.md
docs/

# ── Vercel (legacy; this repo deploys to GKE) ─────────────────────────────────
.vercel/
