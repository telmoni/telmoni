{
  "name": "telmoni",
  "version": "0.2.0",
  "description": "TypeScript & JavaScript SDK for Telmoni: an agent's runs, steps, model calls and tool calls as OpenTelemetry spans",
  "license": "Apache-2.0",
  "author": "Kendrick Lawton",
  "homepage": "https://github.com/telmoni/telmoni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telmoni/telmoni.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "telmoni",
    "sdk",
    "opentelemetry",
    "agents"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
