# Copy to deploy/compose/.env and fill the first six, which have no default:
# each `openssl rand -hex 32`, the KEKs prefixed `local:`. Back up every KEK
# beside the database: a dump restored without them reads nothing they seal.
SERVICE_SECRET=
AUTH_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
TELEMETRY_KEK=
CONTENT_KEK=

# Connectors (Slack, webhooks) stay off without it.
# CONNECTOR_KEK=

# The tags `--build` gives the images it builds from this checkout.
# TELMONI_IMAGE_SERVER=telmoni-server:local
# TELMONI_IMAGE_WEB=telmoni-web:local

# Your domain, behind the TLS proxy (an AUTH_URL off loopback must be https).
# APP_URL=https://telmoni.example.com
# AUTH_URL=https://telmoni.example.com
# AUTH_REDIRECT_URI=https://telmoni.example.com/auth/callback

# The first account, for setup alone (Production → OIDC replaces it).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
